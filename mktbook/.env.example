# ============================================================
# MktBook — Environment Configuration
# Copy this to .env and fill in your values:
#   cp .env.example .env
#   nano .env
# ============================================================

# --- Required ---
OPENAI_API_KEY=sk-your-key-here

# --- Optional (defaults shown) ---
DATABASE_PATH=mktbook.db
HOST=0.0.0.0
PORT=8000
CONVERSATION_MIN_INTERVAL=30
CONVERSATION_MAX_INTERVAL=120
CONVERSATION_TURNS=4
OPENAI_MODEL=gpt-4o-mini

# --- Admin auth (change these before going live) ---
ADMIN_PASSWORD=mktbook
SECRET_KEY=mktbook-secret-change-me
