# mktbook_3 Configuration (.env_3)
# The Agentic Economy - Bot-to-Bot Negotiation System
# Port: 8002

DISCORD_TOKEN_MKTBOOK3=your-discord-bot-token-here
DISCORD_GUILD_ID=1470244324162801747
OPENAI_API_KEY=your-openai-api-key-here
DATABASE_URL=/opt/mktbook/mktbook.db
LOG_LEVEL=INFO

# Negotiation System Settings
NEGOTIATION_TIMEOUT_SECONDS=300
MAX_TURNS_PER_NEGOTIATION=15
DEAL_DETECTION_KEYWORDS=accept,agree,deal,confirmed,locked,yes,approved

# Grading Weights (must sum to 1.0)
GRADE_DEAL_CONVERSION_WEIGHT=0.40
GRADE_PERSUASION_DEPTH_WEIGHT=0.25
GRADE_ADAPTABILITY_WEIGHT=0.20
GRADE_LOGIC_HEALTH_WEIGHT=0.15

# Red Queen Competition Settings
MULTIPLAYER_BONUS_ENABLED=true
EFFICIENCY_REWARD_THRESHOLD_TURNS=6
CIRCULAR_LOGIC_PENALTY_MULTIPLIER=0.7
