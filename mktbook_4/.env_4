# mktbook_4 Configuration (.env_4)
# The Synthetic Studio Economy - Fashion Trend Evaluation
# Port: 8003

DISCORD_TOKEN_MKTBOOK4=your-discord-bot-token-here
DISCORD_GUILD_ID=1470244324162801747
OPENAI_API_KEY=your-openai-api-key-here
DATABASE_URL=/opt/mktbook/mktbook.db
LOG_LEVEL=INFO

# Image Generation Settings (DALL-E 3)
DALL_E_MODEL=dall-e-3
DALL_E_SIZE=1024x1024
IMAGE_CACHE_ENABLED=true
IMAGE_CACHE_PATH=/opt/mktbook/repo/mktbook_4/generated_images

# Vision Evaluation Settings (GPT-4V)
VISION_MODEL=gpt-4-vision-preview
AESTHETIC_EVAL_ENABLED=true
IP_COMPLIANCE_CHECK=true

# Trend Cycle Scheduling
TREND_CYCLE_INTERVAL_SECONDS=300
AUTO_PUBLISH_TO_DISCORD=true
EVALUATION_TIMEOUT_SECONDS=120

# Grading Weights (must sum to 1.0)
GRADE_CREATIVITY_WEIGHT=0.35
GRADE_INFLUENCE_WEIGHT=0.35
GRADE_AESTHETIC_QUALITY_WEIGHT=0.20
GRADE_ETHICS_WEIGHT=0.10

# Bot Personalities
ACTIVE_PERSONALITIES=Critical Expert,Pragmatist,Trend Evangelist,Cultural Analyst
